# =============================================================================
# eladmin-mp Docker Environment Variables
# Copy this file to .env and fill in your values.
# IMPORTANT: .env contains secrets and must NEVER be committed to version control.
# =============================================================================

# ------------------------------
# Backend (Spring Boot)
# ------------------------------
# Spring profile: dev / prod
SPRING_PROFILES_ACTIVE=prod

# MySQL — 填写本地或私有环境数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eladmin
DB_USER=root
DB_PWD=change-me

# Redis — 填写本地或私有环境 Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PWD=change-me

# JWT — 公开仓库只保留占位符，实际值放到本地 .env
JWT_BASE64_SECRET=change-me
RSA_PRIVATE_KEY=change-me
LOGIN_CODE_DEV_BYPASS=

# JVM 堆内存设置
BACKEND_JVM_HEAP_MIN=256m
BACKEND_JVM_HEAP_MAX=512m

# ------------------------------
# Docker image and frontend releases
# ------------------------------
# 后端镜像 tag，由 deploy-from-github.sh 自动生成；手动部署时填写正在运行的版本
BACKEND_IMAGE_TAG=latest
# 前端静态版本目录必须位于服务器本地磁盘；current 与 releases 必须同文件系统
FRONTEND_RELEASE_ROOT=/data/meals/frontend
# 前端静态版本保留数，current 和 previous 即使超出数量也不会被删除
FRONTEND_RELEASE_KEEP=5
