[
  {
    "ruleId": "ORDER_MEAL_BALANCE",
    "topics": ["MEAL_BALANCE", "剩余餐数"],
    "version": "1.1",
    "status": "EFFECTIVE",
    "title": "剩余餐数计算",
    "content": "剩余早餐数 = 订单早餐数 - 未删除 BREAKFAST 核销数；剩余午晚餐数 = 订单午晚餐数 - 未删除 LUNCH 核销数 - 未删除 DINNER 核销数。午餐和晚餐共用午晚餐池，两个剩余值最小为 0。客户维度汇总所有进行中订单，排餐创建或删除不消耗餐数。",
    "ownerModule": "customer-order / meal-verification",
    "evidenceDocument": "doc/business/订单管理业务说明.md",
    "evidenceAnchor": "#餐数体系",
    "evidenceHash": "sha256:b6acc95db63be07b67a76faf446881636a12e84f2fb1f645f92c3fcf35b34c60",
    "effectiveFrom": "2026-07-30T00:00:00+08:00",
    "updatedAt": "2026-07-30T00:00:00+08:00",
    "supersedes": "ORDER_MEAL_BALANCE@1.0"
  },
  {
    "ruleId": "ORDER_EFFECTIVE",
    "topics": ["ORDER_EFFECTIVE", "订单有效性"],
    "version": "1.1",
    "status": "EFFECTIVE",
    "title": "订单有效性",
    "content": "状态为进行中的订单参与当前餐数与排餐候选判断；排餐时还需满足订单有效期、开始餐次、餐次类型、排餐模式和客户排除日期等条件。",
    "ownerModule": "customer-order / meal-plan",
