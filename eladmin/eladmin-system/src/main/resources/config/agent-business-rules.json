  {
    "ruleId": "MEAL_PLAN_MATCH",
    "topics": ["MEAL_PLAN_MATCH"],
    "version": "1.1",
    "status": "EFFECTIVE",
    "title": "排餐模式与餐次匹配",
    "content": "排餐候选订单必须处于进行中状态，且目标日期落在有效期内；订单开始餐次、餐次类型和排餐模式必须覆盖目标餐次。人工新增订单可以绕过排餐模式日期匹配，但仍须满足有效期、开始餐次、餐次类型、客户排除日期和餐数上限校验。",
    "ownerModule": "meal-plan / customer-order",
    "evidenceDocument": "doc/business/排餐管理业务说明.md",
    "evidenceAnchor": "#1. 生成排餐计划",
    "evidenceHash": "sha256:f3e5a35f5cc1468476602f32e475162e87464ae21cd062e4a20fde3417273166",
    "effectiveFrom": "2026-07-30T00:00:00+08:00",
    "updatedAt": "2026-07-30T00:00:00+08:00",
    "supersedes": "MEAL_PLAN_MATCH@1.0"
  },
  {
    "ruleId": "DIETARY_FILTER",
    "topics": ["DIETARY_FILTER"],
    "version": "1.1",
    "status": "EFFECTIVE",
    "title": "排除日期、过敏与忌口过滤",
    "content": "目标日期命中客户排除日期时不参与排餐。候选菜按客户过敏标签和忌口过滤；过敏标签可按配料名、二级分类或一级分类匹配，命中后记录过滤原因。手工换菜优先级最高，已替换菜品不再参与后续过敏过滤。",
    "ownerModule": "meal-plan / customer-profile",
    "evidenceDocument": "doc/business/排餐管理业务说明.md",
    "evidenceAnchor": "#1. 生成排餐计划",
    "evidenceHash": "sha256:f3e5a35f5cc1468476602f32e475162e87464ae21cd062e4a20fde3417273166",
    "effectiveFrom": "2026-07-30T00:00:00+08:00",
    "updatedAt": "2026-07-30T00:00:00+08:00",
    "supersedes": "DIETARY_FILTER@1.0"
  },
  {
    "ruleId": "VERIFICATION_REFUND_EFFECT",
    "topics": ["VERIFICATION_REFUND_EFFECT"],
    "version": "1.1",
    "status": "EFFECTIVE",
    "title": "核销与退餐对餐数的影响",
    "content": "核销以未删除核销日志为准：BREAKFAST 扣减早餐池，LUNCH 和 DINNER 均扣减午晚餐池。退餐只处理未核销餐，已核销餐不属于退餐范围；客服查询会分别展示订单餐数余额、核销记录和退餐记录，Agent 不自行推算未返回的业务数据。",
    "ownerModule": "meal-verification / customer-order",
    "evidenceDocument": "doc/business/核销管理业务说明.md",
    "evidenceAnchor": "#业务规则汇总",
    "evidenceHash": "sha256:0cc659f7c5aadd632cca4b19a4fae866131bd025e43aa88940c9c7e87eca6ee0",
    "effectiveFrom": "2026-07-30T00:00:00+08:00",
    "updatedAt": "2026-07-30T00:00:00+08:00",
    "supersedes": "VERIFICATION_REFUND_EFFECT@1.0"
  }
